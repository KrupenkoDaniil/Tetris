<Application x:Class="Tetris.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="/Tetris.Desktop;component/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#19192C"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#101625"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#20283A"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#6E8C63"/>
        <SolidColorBrush x:Key="TextBrush" Color="#A7F3D0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#BAC7D8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A3E635"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#142005"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#E3F8FF"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#26391F"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#D0101222"/>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ArcadePanel" TargetType="ContentControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Path Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="3" Stretch="Fill"
                                  Data="M 0,12 L 12,0 H 264 L 276,12 V 88 L 264,100 H 12 L 0,88 Z"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArcadeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ArcadeValue" TargetType="TextBlock" BasedOn="{StaticResource ArcadeLabel}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DrawingBrush x:Key="ArcadeCornerTiles" ViewboxUnits="Absolute" Viewbox="0,0,178,148" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#282745"
                        Geometry="M 30,0 H 42 V 12 H 30 Z M 47,0 H 59 V 12 H 47 Z M 64,0 H 76 V 12 H 64 Z M 81,0 H 93 V 12 H 81 Z M 98,0 H 110 V 12 H 98 Z M 115,0 H 127 V 12 H 115 Z M 132,0 H 144 V 12 H 132 Z M 166,0 H 178 V 12 H 166 Z M 13,17 H 25 V 29 H 13 Z M 30,17 H 42 V 29 H 30 Z M 81,17 H 93 V 29 H 81 Z M 13,52 H 25 V 64 H 13 Z M 0,69 H 12 V 81 H 0 Z M 0,103 H 12 V 115 H 0 Z M 17,120 H 29 V 132 H 17 Z M 0,136 H 12 V 148 H 0 Z"/>
                    <GeometryDrawing Brush="#203D48"
                        Geometry="M 47,17 H 59 V 29 H 47 Z M 64,17 H 76 V 29 H 64 Z M 13,34 H 25 V 46 H 13 Z M 30,34 H 42 V 46 H 30 Z M 13,86 H 25 V 98 H 13 Z M 0,120 H 12 V 132 H 0 Z"/>
                    <GeometryDrawing Brush="#215541"
                        Geometry="M 64,34 H 76 V 46 H 64 Z M 30,52 H 42 V 64 H 30 Z M 13,69 H 25 V 81 H 13 Z"/>
                    <GeometryDrawing Brush="#218348"
                        Geometry="M 47,52 H 59 V 64 H 47 Z M 30,69 H 42 V 81 H 30 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ArcadePauseButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="Shape" Fill="{TemplateBinding Background}" Stretch="Fill"
                                  Data="M 0,12 L 12,0 H 264 L 276,12 V 64 L 264,76 H 12 L 0,64 Z"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="Shape" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArcadeCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Padding="8,5" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
