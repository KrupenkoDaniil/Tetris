<Window x:Class="Tetris.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Tetris.Desktop.Presentation"
        Title="Падающие фигуры" Width="1120" Height="740" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded" Closed="OnClosed" Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="37" ResizeBorderThickness="6,4,6,6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="41"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#35364D" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button x:Name="SoundButton" Click="OnToggleSound" MinHeight="26" Padding="9,2"
                            FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ArcadeCaptionButton}" Click="OnMinimizeWindow"
                            AutomationProperties.Name="Свернуть" ToolTip="Свернуть" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 0,7 H 14"/>
                    </Button>
                    <Button Style="{StaticResource ArcadeCaptionButton}" Click="OnToggleMaximizedWindow"
                            AutomationProperties.Name="Развернуть или восстановить" ToolTip="Развернуть или восстановить"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0,0 H 13 V 13 H 0 Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Data" Value="M 4,4 V 0 H 15 V 11 H 11 M 0,4 H 11 V 15 H 0 Z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource ArcadeCaptionButton}" Click="OnCloseWindow"
                            AutomationProperties.Name="Закрыть" ToolTip="Закрыть" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 0,0 L 13,13 M 13,0 L 0,13"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                    <UniformGrid Columns="2" Rows="2" Width="22" Height="22" Margin="0,0,12,0" IsHitTestVisible="False">
                        <Rectangle Fill="#299348" Margin="0,0,1,1"/>
                        <Rectangle Fill="{StaticResource AccentBrush}" Margin="0,0,0,1"/>
                        <Rectangle Fill="{StaticResource AccentBrush}" Margin="0,0,1,0"/>
                        <Rectangle Fill="#299348"/>
                    </UniformGrid>
                    <TextBlock Text="Падающие фигуры" Style="{StaticResource ArcadeLabel}" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="RecordStatusPanel" Style="{StaticResource Panel}"
                Visibility="Collapsed" Padding="12,8" Margin="16,8,16,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RetryRecordsButton"
                        Content="Повторить" Margin="12,0,0,0" Click="OnRetryRecords"/>
                <TextBlock x:Name="RecordStatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,10,16,12">
            <Rectangle Width="178" Height="148" Fill="{StaticResource ArcadeCornerTiles}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            <Rectangle Width="178" Height="148" Fill="{StaticResource ArcadeCornerTiles}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="178" Height="148" Fill="{StaticResource ArcadeCornerTiles}"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="-1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="178" Height="148" Fill="{StaticResource ArcadeCornerTiles}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Grid x:Name="MenuScreen">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,4,24,4">
                    <StackPanel VerticalAlignment="Center" MaxWidth="390">
                        <TextBlock Text="Новая партия" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Заполняй строки, чтобы набирать очки. Каждые 10 очищенных строк повышают уровень." Margin="0,0,0,24"/>
                        <TextBlock Text="Начальный уровень" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <RadioButton x:Name="LevelOne" Style="{StaticResource Choice}" GroupName="Level" Tag="1" Content="1" AutomationProperties.Name="Уровень 1" Margin="0,0,6,0" Checked="OnLevelSelected"/>
                            <RadioButton x:Name="LevelTwo" Style="{StaticResource Choice}" GroupName="Level" Tag="2" Content="2" AutomationProperties.Name="Уровень 2" Margin="0,0,6,0" Checked="OnLevelSelected"/>
                            <RadioButton x:Name="LevelThree" Style="{StaticResource Choice}" GroupName="Level" Tag="3" Content="3" AutomationProperties.Name="Уровень 3" Margin="0,0,6,0" Checked="OnLevelSelected"/>
                            <RadioButton x:Name="LevelFour" Style="{StaticResource Choice}" GroupName="Level" Tag="4" Content="4" AutomationProperties.Name="Уровень 4" Margin="0,0,6,0" Checked="OnLevelSelected"/>
                            <RadioButton x:Name="LevelFive" Style="{StaticResource Choice}" GroupName="Level" Tag="5" Content="5" AutomationProperties.Name="Уровень 5" Checked="OnLevelSelected"/>
                        </UniformGrid>
                        <TextBlock Text="Управление" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <RadioButton x:Name="MenuArrows" Style="{StaticResource Choice}" GroupName="MenuScheme" Tag="Arrows" Content="Стрелки · A / D" Margin="0,0,6,0" Checked="OnSchemeSelected"/>
                            <RadioButton x:Name="MenuHomeRow" Style="{StaticResource Choice}" GroupName="MenuScheme" Tag="HomeRow" Content="J / ; · K / L" Checked="OnSchemeSelected"/>
                        </UniformGrid>
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Начать партию"
                                Click="OnStart"/>
                        <Button x:Name="MenuRecordsButton" Content="Таблица рекордов" Margin="0,8,0,0" Click="OnOpenRecords"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" x:Name="MenuLevelLabel" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="BoardDimensionsLabel" FontWeight="SemiBold"/>
                        </DockPanel>
                        <views:CellSurface Grid.Row="1" x:Name="MenuField" AutomationProperties.Name="Образец игрового поля"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GameScreen" Visibility="Collapsed">
                <Viewbox Stretch="Uniform">
                    <Grid Width="645" Height="650">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="283"/>
                        </Grid.ColumnDefinitions>
                        <views:CellSurface x:Name="GameField" AutomationProperties.Name="Игровое поле"/>
                        <StackPanel Grid.Column="2" x:Name="GameSidebar" Margin="0,7,0,0">
                            <TextBlock Text="Следующая фигура" Style="{StaticResource ArcadeLabel}" Margin="6,0,0,8"/>
                            <ContentControl Style="{StaticResource ArcadePanel}" Height="145" Padding="8" Margin="0,0,19,18" HorizontalAlignment="Stretch">
                                <views:CellSurface x:Name="PiecePreview" AutomationProperties.Name="Следующая фигура"/>
                            </ContentControl>
                            <TextBlock Text="Счёт" Style="{StaticResource ArcadeLabel}" Margin="6,0,0,8"/>
                            <ContentControl Style="{StaticResource ArcadePanel}" Height="86" Padding="12,0" Margin="0,0,19,14">
                                <TextBlock x:Name="ScoreLabel" Style="{StaticResource ArcadeValue}" FontSize="67"
                                           FontWeight="Black" HorizontalAlignment="Center"/>
                            </ContentControl>
                            <TextBlock Text="Строки" Style="{StaticResource ArcadeLabel}" Margin="6,0,0,5"/>
                            <ContentControl Style="{StaticResource ArcadePanel}" Height="45" Padding="18,0" Margin="0,0,19,14">
                                <TextBlock x:Name="ClearedLabel" Style="{StaticResource ArcadeValue}"/>
                            </ContentControl>
                            <TextBlock Text="Уровень" Style="{StaticResource ArcadeLabel}" Margin="6,0,0,5"/>
                            <ContentControl Style="{StaticResource ArcadePanel}" Height="45" Padding="18,0" Margin="0,0,19,28">
                                <TextBlock x:Name="LevelLabel" Style="{StaticResource ArcadeValue}"/>
                            </ContentControl>
                            <Button x:Name="PauseButton" Style="{StaticResource ArcadePauseButton}" Content="Пауза" Height="76"
                                    Margin="0,0,19,0" Click="OnPause">
                                <Button.ToolTip>
                                    <ToolTip Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Пауза · Esc" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="GameControlsLabel" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <Border x:Name="PauseLayer" Background="{StaticResource OverlayBrush}" Visibility="Collapsed"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Border Style="{StaticResource Panel}" Width="380" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Пауза" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Button x:Name="ResumeButton" Style="{StaticResource PrimaryButton}" Content="Возобновить · Esc" Click="OnResume" Margin="0,0,0,16"/>
                        <TextBlock Text="Управление" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <RadioButton x:Name="PauseArrows" Style="{StaticResource Choice}" GroupName="PauseScheme" Tag="Arrows" Content="Стрелки · A / D" Margin="0,0,6,0" Checked="OnSchemeSelected"/>
                            <RadioButton x:Name="PauseHomeRow" Style="{StaticResource Choice}" GroupName="PauseScheme" Tag="HomeRow" Content="J / ; · K / L" Checked="OnSchemeSelected"/>
                        </UniformGrid>
                        <Button x:Name="PauseRecordsButton" Content="Таблица рекордов" Click="OnOpenRecords" Margin="0,0,0,8"/>
                        <Button x:Name="AbandonButton" Content="Выйти из партии" Click="OnReturnToMenu"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="ResultsScreen" Visibility="Collapsed" Style="{StaticResource Panel}" Padding="32"
                    Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Итог партии" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,12,0,22">
                        <StackPanel>
                            <TextBlock Text="Очки" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ResultScoreLabel" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Активное время" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ResultTimeLabel" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>
                    <Button x:Name="ResultRecordsButton" Content="Таблица рекордов" Style="{StaticResource PrimaryButton}" Click="OnOpenRecords" Margin="0,0,0,8"/>
                    <Button Content="Главное меню" Click="OnReturnToMenu"/>
                </StackPanel>
            </Border>

            <Border x:Name="RecordsScreen" Visibility="Collapsed" Style="{StaticResource Panel}" Padding="23">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="RecordsBackButton" DockPanel.Dock="Right" Content="Назад" Click="OnCloseRecords"/>
                        <TextBlock Text="Таблица рекордов" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton x:Name="RecentTab" Style="{StaticResource Choice}" GroupName="RecordTab" Content="Последние 10" MinWidth="118" Margin="0,0,8,0" Checked="OnRecordTabChanged"/>
                        <RadioButton x:Name="TopTab" Style="{StaticResource Choice}" GroupName="RecordTab" Content="Топ-5" MinWidth="84" Checked="OnRecordTabChanged"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="RecordsTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                  RowHeight="39" BorderBrush="{StaticResource StrokeBrush}"
                                  RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource RaisedBrush}"
                                  Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" GridLinesVisibility="None">
                            <DataGrid.Resources>
                                <Style x:Key="RecordText" TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="MinHeight" Value="40"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="2*" ElementStyle="{StaticResource RecordText}"/>
                                <DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="*" ElementStyle="{StaticResource RecordText}"/>
                                <DataGridTextColumn Header="Время" Binding="{Binding ActiveTime}" Width="*" ElementStyle="{StaticResource RecordText}"/>
                                <DataGridTextColumn Header="Начальный уровень" Binding="{Binding InitialLevel}" Width="1.4*" ElementStyle="{StaticResource RecordText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="RecordsEmpty" Text="Завершённых партий пока нет" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
